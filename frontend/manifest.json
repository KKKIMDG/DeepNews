{
  "manifest_version": 3,
  "name": "DeepNews Analyzer",
  "version": "0.1.0",
  "description": "Analyze Naver news articles with keyword highlighting, summary, recommendation, and ad-likeness checks.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "action": {
    "default_title": "DeepNews Analyzer"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
